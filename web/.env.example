# ---------------------------------------------------------------------------
# Storage local: DuckDB. La web lee el archivo en modo solo-lectura.
# Copiá este archivo a .env.local.
# Por defecto usa ../warddata.duckdb (raíz del proyecto); descomentá para overridear.
# ---------------------------------------------------------------------------
DUCKDB_PATH=D:/ward-eye/warddata.duckdb

# Identidad del jugador (para el encabezado del informe/PDF) — del .env raíz
RIOT_REGION=la2
SUMMONER_NAME="Tu Nombre"
SUMMONER_TAG="tag"

# ---------------------------------------------------------------------------
# LLM OpenAI-compatible para el coaching. El dashboard tiene un selector para
# elegir el proveedor por request; cada uno necesita su propio set de vars
# (base URL y API key difieren, no solo el modelo).
# ---------------------------------------------------------------------------

# Groq free tier (default)
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_GROQ_API_KEY=
LLM_GROQ_MODEL=openai/gpt-oss-120b
# Solo para modelos de razonamiento (gpt-oss, qwen3, deepseek-r1): low | medium | high
# Dejar vacío en modelos no-reasoning (ej. llama-3.3-70b-versatile)
LLM_GROQ_REASONING_EFFORT=medium

# Google AI Studio — Gemini (vía su capa OpenAI-compatible)
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GEMINI_API_KEY=
LLM_GEMINI_MODEL=gemini-3.5-flash
# Para gemini-3.5-flash el effort es low/medium/high
LLM_GEMINI_REASONING_EFFORT=high
